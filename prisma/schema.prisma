generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  idUser                        String                    @id @default(uuid())
  nameUser                      String?
  email                         String                    @unique
  password                      String
  phoneNumber                   String?
  address                       String?
  role                          Role                      @default(USER)
  avatar                        String?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  accountType                   AccountType               @default(LOCAL)
  isActive                      Boolean                   @default(false)
  gender                        Gender                    @default(Male)
  level                         Level                     @default(Low)
  xp                            Int                       @default(0)
  xpToNext                      Int                       @default(100)
  currentStreak                 Int                       @default(0)
  lastStudiedAt                 DateTime?
  longestStreak                 Int                       @default(0)
  targetBandScore               Float?
  targetExamDate                DateTime?
  creditBalance                 CreditBalance?
  creditTransactions            CreditTransaction[]
  forumComments                 ForumComment[]
  forumCommentLikes             ForumCommentLikes[]
  forumPosts                    ForumPost[]
  forumPostLikes                ForumPostLikes[]
  forumThreads                  ForumThreads[]
  grammarCategories             GrammarCategory[]
  paymentTransactions           PaymentTransaction[]
  questionTypePerformances      QuestionTypePerformance[]
  teacherReviewTicketsAsTeacher TeacherReviewTicket[]     @relation("TeacherReviewTickets")
  teacherReviewTickets          TeacherReviewTicket[]
  tests                         Test[]
  topics                        Topic[]
  userAnswers                   UserAnswer[]
  grammarProficiencies          UserGrammarProficiency[]
  grammarViolations             UserGrammarViolation[]
  userSpeakingSubmissions       UserSpeakingSubmission[]
  subscriptions                 UserSubscription[]
  userTestResults               UserTestResult[]
  userWritingSubmissions        UserWritingSubmission[]
  verificationCodes             VerificationCode[]
  vocabularies                  Vocabulary[]
  userDailyTaskCompletions      UserDailyTaskCompletion[]
  userStudyPreference           UserStudyPreference?
}

model VerificationCode {
  idCode     String   @id @default(uuid())
  idUser     String
  token      String
  type       OTPType
  expiration DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
}

model Test {
  idTest          String           @id @default(uuid())
  idUser          String
  title           String
  description     String?
  img             String?
  testType        TestType
  /// Total duration in seconds
  duration        Int
  /// Total number of questions
  numberQuestion  Int
  /// Master audio URL (for Listening tests)
  audioUrl        String?
  level           Level            @default(Low)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  parts           Part[]
  speakingTasks   SpeakingTask[]
  user            User             @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  userTestResults UserTestResult[]
  writingTasks    WritingTask[]

  @@index([testType, level])
}

model Part {
  idPart         String          @id @default(uuid())
  idTest         String
  /// e.g. "Part 1", "Section 1"
  namePart       String
  order          Int             @default(0)
  /// Part-level audio (for Listening)
  audioUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  test           Test            @relation(fields: [idTest], references: [idTest], onDelete: Cascade)
  passage        Passage?
  questions      Question[]
  questionGroups QuestionGroup[]

  @@unique([idTest, order])
  @@index([idTest])
}

model Passage {
  idPassage       String   @id @default(uuid())
  idPart          String   @unique
  title           String
  /// Full passage text (HTML/Markdown)
  content         String
  image           String?
  description     String?
  /// Passage-level audio (for Listening passages)
  audioUrl        String?
  numberParagraph Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  part            Part     @relation(fields: [idPart], references: [idPart], onDelete: Cascade)
}

/// A group of questions sharing the same type and instructions.
/// e.g. "Questions 1-5: Choose TRUE, FALSE, or NOT GIVEN"
model QuestionGroup {
  idQuestionGroup String       @id @default(uuid())
  idPart          String
  /// Group heading shown to students
  title           String
  /// Detailed instructions for the group
  instructions    String?
  /// All questions in this group share this type
  questionType    QuestionType
  /// Image for the group (e.g. map, diagram)
  imageUrl        String?
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questions       Question[]
  part            Part         @relation(fields: [idPart], references: [idPart], onDelete: Cascade)

  @@index([idPart, order])
}

/// Polymorphic Question model.
/// The `metadata` JSONB column stores all type-specific data
/// (options, correct answers, coordinates, word banks, etc.).
/// Use the `questionType` discriminator to interpret the metadata.
model Question {
  idQuestion      String        @id @default(uuid())
  idQuestionGroup String
  idPart          String
  /// Global question number within the test
  questionNumber  Int
  /// Question text / prompt
  content         String
  /// Discriminator — mirrors the group type but can differ
  questionType    QuestionType
  /// Type-specific payload (see TS interfaces)
  metadata        Json
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  part            Part          @relation(fields: [idPart], references: [idPart], onDelete: Cascade)
  questionGroup   QuestionGroup @relation(fields: [idQuestionGroup], references: [idQuestionGroup], onDelete: Cascade)
  userAnswers     UserAnswer[]

  @@index([idQuestionGroup, order])
  @@index([idPart, questionNumber])
}

model WritingTask {
  idWritingTask          String                  @id @default(uuid())
  idTest                 String
  title                  String
  taskType               WritingTaskType
  /// Time limit in seconds
  timeLimit              Int
  /// Stimulus image (charts, graphs for Task 1)
  image                  String?
  /// Task instructions
  instructions           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  userWritingSubmissions UserWritingSubmission[]
  test                   Test                    @relation(fields: [idTest], references: [idTest], onDelete: Cascade)
}

model SpeakingTask {
  idSpeakingTask  String                   @id @default(uuid())
  idTest          String
  title           String
  part            SpeakingPartType
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  questions       SpeakingQuestion[]
  test            Test                     @relation(fields: [idTest], references: [idTest], onDelete: Cascade)
  userSubmissions UserSpeakingSubmission[]

  @@unique([idTest, part])
}

model SpeakingQuestion {
  idSpeakingQuestion String       @id @default(uuid())
  idSpeakingTask     String
  /// e.g. "Hometown", "Work/Study"
  topic              String?
  /// Question text
  prompt             String?
  /// Cue card bullet points (Part 2)
  subPrompts         Json?
  preparationTime    Int          @default(0)
  speakingTime       Int          @default(120)
  order              Int          @default(0)
  speakingTask       SpeakingTask @relation(fields: [idSpeakingTask], references: [idSpeakingTask], onDelete: Cascade)

  @@index([idSpeakingTask, order])
}

model UserTestResult {
  idTestResult         String                   @id @default(uuid())
  idUser               String
  idTest               String
  /// Raw score (out of 40 for R/L)
  score                Int?                     @default(0)
  totalCorrect         Int?                     @default(0)
  totalQuestions       Int?                     @default(0)
  rawScore             Int?                     @default(0)
  bandScore            Float                    @default(0)
  /// Actual time spent in seconds
  duration             Int                      @default(0)
  status               TestStatus               @default(IN_PROGRESS)
  level                Level                    @default(Low)
  startedAt            DateTime                 @default(now())
  finishedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  teacherReviewTickets TeacherReviewTicket[]
  userAnswers          UserAnswer[]
  speakingSubmissions  UserSpeakingSubmission[]
  test                 Test                     @relation(fields: [idTest], references: [idTest], onDelete: Cascade)
  user                 User                     @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  writingSubmissions   UserWritingSubmission[]

  @@index([idUser, status, finishedAt])
  @@index([idTest, createdAt])
}

model UserAnswer {
  idUserAnswer  String         @id @default(uuid())
  idUser        String
  idQuestion    String
  idTestResult  String
  /// Mirrors the question type for easy filtering
  answerType    QuestionType
  /// Structured answer (text, selected option index, matching pairs, etc.)
  answerPayload Json
  isCorrect     Boolean        @default(false)
  submittedAt   DateTime       @default(now())
  question      Question       @relation(fields: [idQuestion], references: [idQuestion], onDelete: Cascade)
  testResult    UserTestResult @relation(fields: [idTestResult], references: [idTestResult], onDelete: Cascade)
  user          User           @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@unique([idQuestion, idUser, idTestResult])
  @@index([idTestResult, isCorrect])
}

model UserWritingSubmission {
  idWritingSubmission String          @id @default(uuid())
  idUser              String
  idWritingTask       String
  idTestResult        String?
  /// The student's essay
  submissionText      String
  aiGradingStatus     GradingStatus   @default(PENDING)
  /// Band score (0.0 – 9.0)
  aiOverallScore      Float?
  /// { ta, cc, lr, gra } with scores + comments
  aiDetailedFeedback  Json?
  submittedAt         DateTime        @default(now())
  /// Set when AI worker returns result
  gradedAt            DateTime?
  idCreditTransaction String?
  testResult          UserTestResult? @relation(fields: [idTestResult], references: [idTestResult], onDelete: Cascade)
  user                User            @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  writingTask         WritingTask     @relation(fields: [idWritingTask], references: [idWritingTask], onDelete: Cascade)

  @@index([idUser, aiGradingStatus, submittedAt])
  @@index([aiGradingStatus])
}

model UserSpeakingSubmission {
  idSpeakingSubmission String          @id @default(uuid())
  idUser               String
  idSpeakingTask       String
  idTestResult         String?
  /// Uploaded audio file URL
  audioUrl             String
  /// AI-generated transcript
  transcript           String?
  aiGradingStatus      GradingStatus   @default(PENDING)
  /// Band score (0.0 – 9.0)
  aiOverallScore       Float?
  /// { fc, lr, gra, pronunciation } with scores + comments
  aiDetailedFeedback   Json?
  submittedAt          DateTime        @default(now())
  /// Set when AI worker returns result
  gradedAt             DateTime?
  idCreditTransaction  String?
  speakingTask         SpeakingTask    @relation(fields: [idSpeakingTask], references: [idSpeakingTask], onDelete: Cascade)
  testResult           UserTestResult? @relation(fields: [idTestResult], references: [idTestResult])
  user                 User            @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@index([idUser, aiGradingStatus, submittedAt])
  @@index([aiGradingStatus])
}

model Vocabulary {
  idVocab        String    @id @default(uuid())
  word           String
  phonetic       String?
  meaning        String
  example        String?
  VocabType      VocabType
  level          Level?
  correctStreak  Int       @default(0)
  lastReviewed   DateTime?
  xp             Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  idUser         String
  idTopic        String?
  timesReviewed  Int       @default(0)
  easinessFactor Float     @default(2.5)
  interval       Int       @default(1)
  nextReviewAt   DateTime?
  status         String    @default("new")
  tier           Int       @default(1)
  frequencyRank  Int?
  topic          Topic?    @relation(fields: [idTopic], references: [idTopic], onDelete: Cascade)
  user           User      @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
}

model Topic {
  idTopic    String       @id @default(uuid())
  nameTopic  String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  idUser     String
  user       User         @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  vocabulary Vocabulary[]
}

model GrammarCategory {
  idGrammarCategory String                 @id @default(uuid())
  name              String
  description       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  idUser            String?
  user              User?                  @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  grammars          GrammarsOnCategories[]

  @@unique([idUser, name])
}

model Grammar {
  idGrammar      String                   @id @default(uuid())
  title          String
  explanation    String
  level          Level                    @default(Low)
  commonMistakes Json?
  examples       Json?
  order          Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  exercises      GrammarExercise[]
  categories     GrammarsOnCategories[]
  proficiencies  UserGrammarProficiency[]
  violations     UserGrammarViolation[]
}

model GrammarsOnCategories {
  idGrammarCategory String
  idGrammar         String
  assignedAt        DateTime        @default(now())
  assignedBy        String
  category          GrammarCategory @relation(fields: [idGrammarCategory], references: [idGrammarCategory], onDelete: Cascade)
  grammar           Grammar         @relation(fields: [idGrammar], references: [idGrammar], onDelete: Cascade)

  @@id([idGrammarCategory, idGrammar])
}

model GrammarExercise {
  id          String                      @id @default(uuid())
  idGrammar   String
  type        String
  content     Json
  order       Int                         @default(0)
  createdAt   DateTime                    @default(now())
  grammar     Grammar                     @relation(fields: [idGrammar], references: [idGrammar], onDelete: Cascade)
  userResults UserGrammarExerciseResult[]
}

model UserGrammarProficiency {
  idUser             String
  idGrammar          String
  proficiency        String
  totalAttempts      Int      @default(0)
  correctCount       Int      @default(0)
  wrongCount         Int      @default(0)
  updatedAt          DateTime @updatedAt
  violations         Int      @default(0)
  consecutiveCorrect Int      @default(0)
  grammar            Grammar  @relation(fields: [idGrammar], references: [idGrammar])
  user               User     @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@id([idUser, idGrammar])
}

model UserGrammarViolation {
  id                String   @id @default(uuid())
  idUser            String
  source            String
  idGrammar         String
  submissionId      String
  userSentence      String
  correctedSentence String
  createdAt         DateTime @default(now())
  grammar           Grammar  @relation(fields: [idGrammar], references: [idGrammar])
  user              User     @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@index([idUser, idGrammar])
}

model UserGrammarExerciseResult {
  id          String          @id @default(uuid())
  idUser      String
  idExercise  String
  answer      String
  isCorrect   Boolean
  attemptedAt DateTime        @default(now())
  exercise    GrammarExercise @relation(fields: [idExercise], references: [id])
}

model UserGrammarExerciseSR {
  id           String   @id @default(uuid())
  idUser       String
  idExercise   String
  interval     Int      @default(1)
  nextReviewAt DateTime
  easeFactor   Float    @default(2.5)

  @@unique([idUser, idExercise])
}

model ForumThreads {
  idForumThreads String      @id @default(uuid())
  idUser         String
  title          String
  content        String
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  forumPost      ForumPost[]
  user           User        @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
}

model ForumPost {
  idForumPost      String                @id @default(uuid())
  idForumThreads   String
  idUser           String
  content          String
  file             String?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt
  moderationStatus ForumModerationStatus @default(PENDING)
  moderationScore  Int?
  moderationMeta   Json?
  reviewedBy       String?
  reviewedAt       DateTime?
  forumComment     ForumComment[]
  forumThreads     ForumThreads          @relation(fields: [idForumThreads], references: [idForumThreads], onDelete: Cascade)
  user             User                  @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  forumPostLikes   ForumPostLikes[]

  @@index([idForumThreads, created_at])
  @@index([moderationStatus, created_at])
}

model ForumComment {
  idForumComment    String              @id @default(uuid())
  idForumPost       String
  idUser            String
  content           String
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  forumPost         ForumPost           @relation(fields: [idForumPost], references: [idForumPost], onDelete: Cascade)
  user              User                @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  forumCommentLikes ForumCommentLikes[]
}

model ForumPostLikes {
  idForumPostLikes String    @id @default(uuid())
  idForumPost      String
  idUser           String
  created_at       DateTime  @default(now())
  forumPost        ForumPost @relation(fields: [idForumPost], references: [idForumPost], onDelete: Cascade)
  user             User      @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@unique([idForumPost, idUser])
}

model ForumCommentLikes {
  idForumCommentLikes String       @id @default(uuid())
  idForumComment      String
  idUser              String
  created_at          DateTime     @default(now())
  forumComment        ForumComment @relation(fields: [idForumComment], references: [idForumComment], onDelete: Cascade)
  user                User         @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@unique([idForumComment, idUser])
}

model CreditPackage {
  idPackage           String               @id @default(uuid())
  name                String               @unique
  description         String?
  creditAmount        Int
  price               Float
  priceUnit           String               @default("VND")
  isActive            Boolean              @default(true)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  transactions        CreditTransaction[]
  paymentTransactions PaymentTransaction[]

  @@index([isActive, sortOrder])
}

model CreditBalance {
  idUser        String              @id @default(uuid())
  totalCredits  Int                 @default(0)
  usedCredits   Int                 @default(0)
  frozenCredits Int                 @default(0)
  user          User                @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  transactions  CreditTransaction[]

  @@index([idUser])
}

model CreditTransaction {
  idTransaction        String              @id @default(uuid())
  idUser               String
  idPackage            String?
  creditsAmount        Int
  transactionType      CreditTransType
  description          String?
  idWritingSubmission  String?
  idSpeakingSubmission String?
  status               CreditTransStatus   @default(PENDING)
  createdAt            DateTime            @default(now())
  creditBalanceIdUser  String?
  creditBalance        CreditBalance?      @relation(fields: [creditBalanceIdUser], references: [idUser])
  package              CreditPackage?      @relation(fields: [idPackage], references: [idPackage])
  user                 User                @relation(fields: [idUser], references: [idUser], onDelete: Cascade)
  paymentTransaction   PaymentTransaction?

  @@index([idUser, createdAt])
  @@index([transactionType, createdAt])
}

model SubscriptionPackage {
  idPackage           String               @id @default(uuid())
  name                String               @unique
  description         String?
  billingCycle        BillingCycle         @default(MONTHLY)
  price               Float
  priceUnit           String               @default("VND")
  creditsQuota        Int                  @default(0)
  features            String[]
  badge               String?
  isActive            Boolean              @default(true)
  isFeatured          Boolean              @default(false)
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  paymentTransactions PaymentTransaction[]
  subscriptions       UserSubscription[]

  @@index([isActive, sortOrder])
  @@index([billingCycle])
}

model UserSubscription {
  idSubscription         String              @id @default(uuid())
  idUser                 String
  idPackage              String
  status                 SubscriptionStatus  @default(ACTIVE)
  startedAt              DateTime            @default(now())
  expiresAt              DateTime
  nextBillingAt          DateTime?
  autoRenew              Boolean             @default(true)
  creditsUsedThisPeriod  Int                 @default(0)
  creditsQuotaThisPeriod Int                 @default(0)
  paymentRef             String?
  paymentMethod          PaymentMethod?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  paymentTransaction     PaymentTransaction?
  package                SubscriptionPackage @relation(fields: [idPackage], references: [idPackage])
  user                   User                @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@index([idUser, status])
  @@index([expiresAt])
}

model PaymentTransaction {
  idTransaction         String               @id @default(uuid())
  idUser                String
  packageType           PaymentPackageType
  idCreditPackage       String?
  idSubscriptionPackage String?
  amount                Float
  priceUnit             String               @default("VND")
  paymentMethod         PaymentMethod        @default(VNPAY)
  status                PaymentStatus        @default(PENDING)
  vnpTxnRef             String               @unique
  vnpTransactionNo      String?
  vnpResponseCode       String?
  vnpBankCode           String?
  vnpPayDate            String?
  rawCallback           Json?
  idCreditTransaction   String?              @unique
  idSubscription        String?              @unique
  ipAddress             String?
  errorMessage          String?
  createdAt             DateTime             @default(now())
  paidAt                DateTime?
  updatedAt             DateTime             @updatedAt
  creditPackage         CreditPackage?       @relation(fields: [idCreditPackage], references: [idPackage])
  creditTransaction     CreditTransaction?   @relation(fields: [idCreditTransaction], references: [idTransaction])
  subscriptionPackage   SubscriptionPackage? @relation(fields: [idSubscriptionPackage], references: [idPackage])
  subscription          UserSubscription?    @relation(fields: [idSubscription], references: [idSubscription])
  user                  User                 @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@index([idUser, status])
  @@index([status, createdAt])
  @@index([vnpTxnRef])
}

model TeacherReviewTicket {
  idTicket         String              @id @default(uuid())
  idTestResult     String
  idUser           String
  type             ReviewType
  status           TeacherReviewStatus @default(PENDING)
  aiBandScore      Float?
  aiFeedback       Json?
  idTeacher        String?
  claimedAt        DateTime?
  teacherBandScore Float?
  teacherFeedback  Json?
  submittedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  commissionAmount Float?
  teacher          User?               @relation("TeacherReviewTickets", fields: [idTeacher], references: [idUser])
  testResult       UserTestResult      @relation(fields: [idTestResult], references: [idTestResult], onDelete: Cascade)
  user             User                @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([idTeacher, status])
  @@index([idUser, status])
}

model SystemConfig {
  idConfig   String     @id @unique
  value      Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  assignMode AssignMode @default(MANUAL)
}

model AuditLog {
  idAuditLog  String   @id @default(uuid())
  actorId     String
  actorName   String?
  actorRole   Role
  action      String
  targetType  String
  targetId    String?
  beforeValue Json?
  afterValue  Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model QuestionTypePerformance {
  id            String    @id @default(uuid())
  idUser        String
  skillType     String
  questionType  String
  totalAttempts Int       @default(0)
  correctCount  Int       @default(0)
  errorRate     Float     @default(0)
  lastAttemptAt DateTime?
  user          User      @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@unique([idUser, skillType, questionType])
}

model UserDailyTaskCompletion {
  id          String    @id @default(uuid())
  idUser      String
  idStudyPlan String
  taskType    String
  date        DateTime  @db.Date
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@unique([idUser, idStudyPlan, taskType, date])
  @@map("user_daily_task_completion")
}

model UserStudyPreference {
  id                    String   @id @default(uuid())
  idUser                String   @unique
  dailyMinutesAvailable Int      @default(60)
  updatedAt             DateTime @updatedAt
  currentStage          String   @default("FOUNDATION")
  weeksInCurrentStage   Int      @default(0)
  stageStartDate        DateTime @default(now())
  user                  User     @relation(fields: [idUser], references: [idUser], onDelete: Cascade)

  @@map("user_study_preference")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentPackageType {
  CREDIT
  SUBSCRIPTION
}

enum CreditTransType {
  PURCHASE
  USED_WRITING
  USED_SPEAKING
  REFUND
  EXPIRY
  BONUS
  ADMIN_ADJUST
}

enum CreditTransStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

